#!/bin/bash
set -euxo pipefail

CLUSTER_NAME="${cluster_name}"
AWS_REGION="${aws_region}"
CONTROL_PLANE_ENDPOINT="${control_plane_endpoint}"

cat >/etc/modules-load.d/k8s.conf <<'EOF'
overlay
br_netfilter
EOF
modprobe overlay
modprobe br_netfilter

cat >/etc/sysctl.d/99-kubernetes-cri.conf <<'EOF'
net.bridge.bridge-nf-call-iptables  = 1
net.ipv4.ip_forward                 = 1
net.bridge.bridge-nf-call-ip6tables = 1
EOF
sysctl --system

yum update -y
yum install -y containerd curl bash-completion

mkdir -p /etc/containerd
containerd config default >/etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
systemctl enable containerd
systemctl restart containerd

cat >/etc/yum.repos.d/kubernetes.repo <<'EOF'
[kubernetes]
name=Kubernetes
baseurl=https://pkgs.k8s.io/core:/stable:/v1.30/rpm/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://pkgs.k8s.io/core:/stable:/v1.30/rpm/repodata/repomd.xml.key
EOF

yum install -y kubelet kubeadm kubectl
systemctl enable kubelet

cat >/etc/cluster-info <<EOF
cluster_name=$${CLUSTER_NAME}
aws_region=$${AWS_REGION}
control_plane_endpoint=$${CONTROL_PLANE_ENDPOINT}
EOF

# Join command is intentionally not executed automatically.
# Use SSM or orchestration tooling to run kubeadm join after control-plane is ready.
